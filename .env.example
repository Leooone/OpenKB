# LLM API key (required) — works with any LiteLLM-supported provider
# OpenAI:    LLM_API_KEY=sk-...
# Anthropic: LLM_API_KEY=sk-ant-...
# Gemini:    LLM_API_KEY=AIza...
# DeepSeek:  LLM_API_KEY=sk-...
LLM_API_KEY=your-key-here

# PageIndex rate limiting (optional)
# Max concurrent in-flight LLM calls during indexing (default: 5)
PAGEINDEX_MAX_CONCURRENCY=1

# Requests-per-minute cap for LLM calls (default: 0 = disabled)
# Set to 20–30 for MiniMax Token Plan; prevents HTTP 429 rate limits
PAGEINDEX_RPM_LIMIT=20
